{
  "title": "HRMS — Platform Overview",
  "tags": ["hrms"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "title": "Up / Down Services",
      "type": "stat",
      "gridPos": {"x":0,"y":0,"w":6,"h":4},
      "targets": [{"expr": "sum(up{job=\"hrms-services\"})", "refId":"A"}]
    },
    {
      "title": "Request rate (5m)",
      "type": "timeseries",
      "gridPos": {"x":6,"y":0,"w":18,"h":8},
      "targets": [{"expr": "sum by (application) (rate(http_server_requests_seconds_count[5m]))", "refId":"A"}]
    },
    {
      "title": "p95 latency (ms)",
      "type": "timeseries",
      "gridPos": {"x":0,"y":8,"w":12,"h":8},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (application,le) (rate(http_server_requests_seconds_bucket[5m]))) * 1000", "refId":"A"}]
    },
    {
      "title": "Error rate",
      "type": "timeseries",
      "gridPos": {"x":12,"y":8,"w":12,"h":8},
      "targets": [{"expr": "sum by (application) (rate(http_server_requests_seconds_count{status=~\"5..\"}[5m]))", "refId":"A"}]
    },
    {
      "title": "Outbox lag (unsent events)",
      "type": "timeseries",
      "gridPos": {"x":0,"y":16,"w":12,"h":8},
      "targets": [{"expr": "sum by (application) (jdbc_connections_active)", "refId":"A"}]
    },
    {
      "title": "JVM heap used",
      "type": "timeseries",
      "gridPos": {"x":12,"y":16,"w":12,"h":8},
      "targets": [{"expr": "sum by (application) (jvm_memory_used_bytes{area=\"heap\"})", "refId":"A"}]
    }
  ]
}
