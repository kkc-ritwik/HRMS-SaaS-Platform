# ═══════════════════════════════════════════════════════════════════════════
#  HRMS Platform — Environment Configuration
#  Copy this file to `.env` and fill in the placeholder values marked
#  REPLACE_ME before running any service in production.
#  Local development can use the defaults provided.
# ═══════════════════════════════════════════════════════════════════════════

# ─── Core: Database ────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5433
DB_NAME=hrms_db
DB_USER=hrms_user
DB_PASSWORD=hrms_pass

# ─── Core: Redis ───────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Core: Kafka ───────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ─── Core: Elasticsearch ───────────────────────────────────────────────────
ELASTICSEARCH_URI=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# ─── Core: Service Discovery ───────────────────────────────────────────────
EUREKA_SERVER_URL=http://localhost:8761/eureka/

# ─── JWT ───────────────────────────────────────────────────────────────────
# Generate a 64-byte random string for production: openssl rand -base64 64
JWT_SECRET=REPLACE_ME_with_a_64_byte_random_secret_for_HS512_signing_keep_it_safe
JWT_ACCESS_EXPIRY_MS=3600000
JWT_REFRESH_EXPIRY_MS=604800000

# ─── File Storage (MinIO / S3) ─────────────────────────────────────────────
# For AWS S3 in prod: STORAGE_ENDPOINT=https://s3.amazonaws.com  STORAGE_PATH_STYLE=false
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=hrms_minio
STORAGE_SECRET_KEY=hrms_minio_secret
STORAGE_REGION=us-east-1
STORAGE_DEFAULT_BUCKET=hrms
STORAGE_PATH_STYLE=true
STORAGE_MAX_UPLOAD_BYTES=52428800
STORAGE_PRESIGN_TTL_SECONDS=3600

# ─── Email (SMTP) ──────────────────────────────────────────────────────────
# DEV: use MailHog (host=localhost, port=1025, no auth)
# PROD: Gmail/Workspace, SES, SendGrid, etc. Example values shown.
MAIL_ENABLED=true
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SSL=false
SMTP_STARTTLS=false
MAIL_FROM=noreply@yourcompany.com
MAIL_FROM_NAME=HRMS
MAIL_REPLY_TO=
MAIL_BCC_AUDIT=
# Example production overrides:
#   SMTP_HOST=email-smtp.us-east-1.amazonaws.com   SMTP_PORT=587   SMTP_STARTTLS=true
#   SMTP_USERNAME=AKIA…   SMTP_PASSWORD=REPLACE_ME

# ─── SMS (Twilio) ──────────────────────────────────────────────────────────
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=REPLACE_ME
TWILIO_AUTH_TOKEN=REPLACE_ME
TWILIO_FROM_NUMBER=+15555555555

# ─── Push Notifications (Firebase Cloud Messaging) ─────────────────────────
# Path to Firebase service-account JSON (download from Firebase console)
FCM_SERVICE_ACCOUNT_PATH=/etc/hrms/firebase-service-account.json
FCM_PROJECT_ID=REPLACE_ME

# ─── WhatsApp (via Twilio WhatsApp API) ────────────────────────────────────
WHATSAPP_FROM_NUMBER=whatsapp:+14155238886

# ─── Slack Integration ─────────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-REPLACE_ME
SLACK_SIGNING_SECRET=REPLACE_ME

# ─── Microsoft Teams Integration ───────────────────────────────────────────
TEAMS_WEBHOOK_URL=REPLACE_ME

# ─── Google Workspace / Calendar OAuth ─────────────────────────────────────
GOOGLE_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=REPLACE_ME
GOOGLE_REDIRECT_URI=https://yourapp.com/oauth/google/callback

# ─── Microsoft 365 / Outlook OAuth ─────────────────────────────────────────
MS_CLIENT_ID=REPLACE_ME
MS_CLIENT_SECRET=REPLACE_ME
MS_TENANT_ID=REPLACE_ME

# ─── E-signature (DocuSign — pick one provider) ────────────────────────────
DOCUSIGN_INTEGRATION_KEY=REPLACE_ME
DOCUSIGN_USER_ID=REPLACE_ME
DOCUSIGN_ACCOUNT_ID=REPLACE_ME
DOCUSIGN_RSA_PRIVATE_KEY_PATH=/etc/hrms/docusign-rsa.pem
DOCUSIGN_BASE_URL=https://demo.docusign.net/restapi

# ─── Aadhaar e-Sign (India) ────────────────────────────────────────────────
AADHAAR_ESIGN_PROVIDER_URL=REPLACE_ME
AADHAAR_ESIGN_API_KEY=REPLACE_ME

# ─── Background Verification ───────────────────────────────────────────────
BGV_PROVIDER=authbridge
BGV_API_KEY=REPLACE_ME
BGV_BASE_URL=https://api.authbridge.com

# ─── ATS / Job Board Integrations ──────────────────────────────────────────
LINKEDIN_API_CLIENT_ID=REPLACE_ME
LINKEDIN_API_CLIENT_SECRET=REPLACE_ME
INDEED_PUBLISHER_ID=REPLACE_ME
NAUKRI_API_KEY=REPLACE_ME

# ─── OAuth2 / SSO (login as) ──────────────────────────────────────────────
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=
OAUTH_OKTA_ISSUER_URI=
OAUTH_OKTA_CLIENT_ID=
OAUTH_OKTA_CLIENT_SECRET=

# ─── Bank API for Payroll Disbursement ────────────────────────────────────
BANK_API_PROVIDER=icici
BANK_API_CLIENT_ID=REPLACE_ME
BANK_API_CLIENT_SECRET=REPLACE_ME
BANK_API_BASE_URL=https://api.icicibank.com

# ─── PF / ESI Statutory Portals (for ECR generation reference) ────────────
EPFO_ESTABLISHMENT_ID=REPLACE_ME
ESIC_EMPLOYER_CODE=REPLACE_ME

# ─── Tax Filing (NSDL / Income Tax) ───────────────────────────────────────
NSDL_TAN_NUMBER=REPLACE_ME
INCOME_TAX_PORTAL_USERNAME=
INCOME_TAX_PORTAL_PASSWORD=

# ─── Currency Rates (placeholder rates relative to base) ──────────────────
HRMS_CURRENCY_BASE=INR
# Format: CCY:rate-to-1-base ; comma-separated.
# Example: 1 USD = 0.012 INR-base ratio (USD per INR). For demo: 1 USD = 83.2 INR => USD:83.2
HRMS_CURRENCY_RATES=USD:83.2,EUR:90.1,GBP:104.5,AED:22.6,SGD:62.1

# ─── Rate Limiting ─────────────────────────────────────────────────────────
HRMS_RATELIMIT_ENABLED=true
HRMS_RATELIMIT_RPM=300

# ─── Tracing (OTel) ────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_RESOURCE_ATTRIBUTES=service.namespace=hrms,deployment.environment=local

# ─── API Keys (inbound webhooks / partner integrations) ───────────────────
HRMS_API_KEY_ENABLED=false
HRMS_API_KEYS=

# ─── Security: Password Policy & Lockout ──────────────────────────────────
HRMS_PWD_MIN_LENGTH=10
HRMS_PWD_MAX_AGE_DAYS=90
HRMS_PWD_HISTORY=5
HRMS_LOCKOUT_MAX_ATTEMPTS=5
HRMS_LOCKOUT_MINUTES=15

# ─── Frontend URL (for password-reset / verification links) ───────────────
FRONTEND_BASE_URL=http://localhost:5173
