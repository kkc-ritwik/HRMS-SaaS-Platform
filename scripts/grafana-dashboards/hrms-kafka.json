{
  "title": "HRMS — Kafka & Events",
  "uid": "hrms-kafka",
  "schemaVersion": 39,
  "refresh": "30s",
  "panels": [
    { "type": "stat", "title": "Producer throughput (msg/s)",
      "targets": [{ "expr": "sum(rate(kafka_producer_record_send_total[1m]))" }],
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 4 } },
    { "type": "stat", "title": "Consumer throughput (msg/s)",
      "targets": [{ "expr": "sum(rate(kafka_consumer_records_consumed_total[1m]))" }],
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 4 } },
    { "type": "stat", "title": "Consumer lag (max)",
      "targets": [{ "expr": "max(kafka_consumer_records_lag_max)" }],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "value": null, "color": "green" }, { "value": 1000, "color": "red" }] } } },
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 4 } },
    { "type": "timeseries", "title": "Consumer lag by group",
      "targets": [{ "expr": "kafka_consumer_records_lag_max", "legendFormat": "{{client_id}}/{{topic}}" }],
      "gridPos": { "x": 0, "y": 4, "w": 24, "h": 8 } },
    { "type": "timeseries", "title": "Outbox pending events",
      "targets": [{ "expr": "hrms_events_outbox_pending", "legendFormat": "{{application}}" }],
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 } },
    { "type": "timeseries", "title": "DLQ messages received",
      "targets": [{ "expr": "rate(kafka_topic_partition_current_offset{topic=~\".*\\\\.DLQ\"}[5m])", "legendFormat": "{{topic}}" }],
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 } }
  ]
}
