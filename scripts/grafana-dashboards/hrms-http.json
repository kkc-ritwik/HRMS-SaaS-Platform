{
  "title": "HRMS — HTTP traffic",
  "uid": "hrms-http",
  "schemaVersion": 39,
  "refresh": "30s",
  "templating": {
    "list": [
      { "name": "service", "type": "query", "datasource": "Prometheus",
        "query": "label_values(http_server_requests_seconds_count, application)",
        "includeAll": true, "multi": true }
    ]
  },
  "panels": [
    { "type": "stat", "title": "Req/s",
      "targets": [{ "expr": "sum(rate(http_server_requests_seconds_count{application=~\"$service\"}[1m]))" }],
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 } },
    { "type": "stat", "title": "5xx/s",
      "targets": [{ "expr": "sum(rate(http_server_requests_seconds_count{application=~\"$service\",status=~\"5..\"}[1m]))" }],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "value": null, "color": "green" }, { "value": 1, "color": "red" }] } } },
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 } },
    { "type": "stat", "title": "p99 latency",
      "targets": [{ "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{application=~\"$service\"}[5m])))" }],
      "fieldConfig": { "defaults": { "unit": "s" } },
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 } },
    { "type": "stat", "title": "429 (rate-limited)/min",
      "targets": [{ "expr": "sum(rate(http_server_requests_seconds_count{application=~\"$service\",status=\"429\"}[5m]))*60" }],
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 } },
    { "type": "timeseries", "title": "Requests/s by service",
      "targets": [{ "expr": "sum by (application) (rate(http_server_requests_seconds_count{application=~\"$service\"}[1m]))", "legendFormat": "{{application}}" }],
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 } },
    { "type": "timeseries", "title": "Error rate by service",
      "targets": [{ "expr": "sum by (application) (rate(http_server_requests_seconds_count{application=~\"$service\",status=~\"5..\"}[5m])) / sum by (application) (rate(http_server_requests_seconds_count{application=~\"$service\"}[5m]))", "legendFormat": "{{application}}" }],
      "fieldConfig": { "defaults": { "unit": "percentunit" } },
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 } },
    { "type": "timeseries", "title": "Latency p50/p95/p99",
      "targets": [
        { "expr": "histogram_quantile(0.5, sum by (le) (rate(http_server_requests_seconds_bucket{application=~\"$service\"}[5m])))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{application=~\"$service\"}[5m])))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{application=~\"$service\"}[5m])))", "legendFormat": "p99" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } },
      "gridPos": { "x": 0, "y": 12, "w": 24, "h": 8 } },
    { "type": "table", "title": "Top 10 slowest endpoints",
      "targets": [{ "expr": "topk(10, histogram_quantile(0.95, sum by (uri, application, le) (rate(http_server_requests_seconds_bucket{application=~\"$service\"}[5m]))))", "format": "table" }],
      "gridPos": { "x": 0, "y": 20, "w": 24, "h": 8 } }
  ]
}
